[Unit]
Description=Granger Network router (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=granger
Group=granger
Environment=PYTHONPATH=/opt/granger-node/runtime/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/granger-node
ExecStartPre=/opt/granger-node/granger-node verify
ExecStart=/opt/granger-node/runtime/venv/bin/python3 -B -m granger_network.operator run --config /etc/granger-node/%i.json --state-dir /var/lib/granger-node/%i --public-dir /var/lib/granger-node/public/%i --pid-file /run/granger-node/%i/node.pid --ready-file /run/granger-node/%i/ready.json --status-file /run/granger-node/%i/status.json --diagnostics /var/log/granger-node/%i-diagnostics.jsonl
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM
UMask=0077
RuntimeDirectory=granger-node/%i
RuntimeDirectoryMode=0750
StateDirectory=granger-node
StateDirectoryMode=0700
LogsDirectory=granger-node
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=4096
TasksMax=256
# Keep the soft reclaim threshold above the measured warm router footprint.
MemoryHigh=128M
MemoryMax=160M

[Install]
WantedBy=multi-user.target
