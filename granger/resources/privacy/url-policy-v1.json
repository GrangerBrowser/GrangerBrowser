    "oly_anon_id",
    "oly_enc_id",
    "rb_clickid",
    "ref_src",
    "ref_url",
    "s_cid",
    "soc_src",
    "soc_trk",
    "spm",
    "ttclid",
    "twclid",
    "vero_conv",
    "vero_id",
    "wbraid",
    "wickedid",
    "yclid"
  ],
  "protectedParameters": [
    "access_token",
    "auth",
    "authorization",
    "code",
    "credential",
    "expires",
    "expiry",
    "hmac",
    "id_token",
    "jwt",
    "key-pair-id",
