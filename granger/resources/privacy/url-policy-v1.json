  "protectedPathFragments": [
    "/authorize",
    "/callback",
    "/checkout",
    "/download/",
    "/email/verify",
    "/oauth",
    "/payment",
    "/password/reset",
    "/reset-password",
    "/saml",
    "/sso",
    "/verify-email"
  ],
  "redirectWrappers": [
    { "host": "google.com", "path": "/url", "parameter": "q" },
    { "host": "google.com", "path": "/url", "parameter": "url" },
    { "host": "facebook.com", "path": "/l.php", "parameter": "u" },
    { "host": "l.instagram.com", "path": "/", "parameter": "u" },
    { "host": "youtube.com", "path": "/redirect", "parameter": "q" },
    { "host": "out.reddit.com", "path": "/", "parameter": "url" },
    { "host": "steamcommunity.com", "path": "/linkfilter/", "parameter": "url" },
    { "host": "vk.com", "path": "/away.php", "parameter": "to" }
  ]
}
