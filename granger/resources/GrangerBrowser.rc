#include <windows.h>

#define IDI_GRANGER_BROWSER 101

IDI_GRANGER_BROWSER ICON "GrangerBrowser.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,4,0
 PRODUCTVERSION 0,4,4,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Granger Browser Project\0"
            VALUE "FileDescription", "Granger Browser privacy browser\0"
            VALUE "FileVersion", "0.4.4\0"
            VALUE "InternalName", "GrangerBrowser\0"
            VALUE "OriginalFilename", "GrangerBrowser.exe\0"
            VALUE "ProductName", "Granger Browser\0"
            VALUE "ProductVersion", "0.4.4\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
