#include <windows.h>
#include "resource.h"

IDI_GRANGER_SETUP ICON "@GRANGER_ICON_RESOURCE_PATH@"
IDR_EMMA_GIF RCDATA "@EMMA_GIF_RESOURCE_PATH@"
@GRANGER_RELEASE_RESOURCE_LINES@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Granger Browser Project\0"
            VALUE "FileDescription", "Granger Browser bootstrap installer\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "GrangerSetup\0"
            VALUE "OriginalFilename", "GrangerSetup.exe\0"
            VALUE "ProductName", "Granger Browser Setup\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
